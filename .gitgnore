# R36S-ish Template - ignore policy v0.2
# Track source, research, catalogs, tests and original redistributable assets.
# Ignore secrets, local assistant memory, caches and reproducible artifacts.

# Local/private workspaces (recursive; never commit)
.dev/
**/.dev/
.agents/
**/.agents/
.codex/
**/.codex/
.claude/
**/.claude/
AGENTS.md
**/AGENTS.md

# Credentials, keys, private configuration
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.token
**/token.txt
**/token.json
**/credentials.json
**/secrets.json
**/id_rsa
**/id_ed25519

# Python caches, test output, local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.venv/
venv/

# Local editors, IDE and operating system metadata
.vscode/
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini

# Generated build outputs (including the original project's paths)
/dist/
/build/
/builds/
/out/
/releases/
/artifacts/
/projects/
node_modules/
**/node_modules/
apps/central/build/host-lua/
apps/central/build/deploy/
*.love
*.love.json
*.tar.gz
*.tgz
theme.tar.gz

# Local logs / benchmark traces / profiler output
*.log
*.log.*
*.trace
*.prof
perf.csv
*.roundtrip.*
*.tmp
*.temp
*.bak
*.orig
*.rej

# LÖVE save data belongs to the platform, not to this repository.
# Never ignore *.lua, *.md, *.json, *.png, *.wav, or *.ttf globally:
# legitimate source code, documents and appropriately licensed assets must be tracked.
